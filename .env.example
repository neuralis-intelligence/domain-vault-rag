# Lines of business: datasets the user can pick (see config/lobs.toml)
LOB_REGISTRY_PATH=config/lobs.toml

# DuckDB Configuration (built by `python -m ingestion.load_duckdb`)
DUCKDB_PATH=data/processed/complaints.duckdb

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Models offered in the UI: a comma-separated allowlist, or empty for every installed
# chat model up to MAX_MODEL_SIZE_GB. OLLAMA_MODEL is the default selection.
ALLOWED_MODELS=
MAX_MODEL_SIZE_GB=10
# Alternative models: llama3.1:8b, mistral:7b
# Ollama URL used by the dockerised API (default: Ollama running natively on the host)
# OLLAMA_HOST_DOCKER=http://host.docker.internal:11434

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=120

# RAG Configuration
RAG_TOP_K=5
# Cosine similarity cutoff for bge-small (relevant matches typically score 0.5-0.85)
RAG_SCORE_THRESHOLD=0.5

# SQL Configuration
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=30
