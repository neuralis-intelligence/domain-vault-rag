# BigQuery Configuration
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=cfpb_complaints
BIGQUERY_TABLE=complaints
GOOGLE_APPLICATION_CREDENTIALS=./credentials/bigquery-key.json

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=complaint_narratives

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Alternative models: llama3.1:8b, mistral:7b

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# RAG Configuration
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# SQL Configuration
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=30

# Groq API (backup LLM provider)
# GROQ_API_KEY=your-groq-api-key-here
